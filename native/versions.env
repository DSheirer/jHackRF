# Pinned native sources for jHackRF releases. Sourced by the build scripts and
# read by the GitHub workflows. To move to a new upstream release, change these
# values and open a pull request.
#
# HACKRF_REF is the upstream tag or full commit to build. HACKRF_VERSION must
# equal the release that host/cmake/set_release.cmake names at that ref, which
# the build checks. It is also the jHackRF version.
HACKRF_REPOSITORY=https://github.com/greatscottgadgets/hackrf.git
HACKRF_REF=v2026.01.3
HACKRF_VERSION=2026.01.3
LIBUSB_VERSION=1.0.30
LIBUSB_TARBALL_SHA256=fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
LIBUSB_WINDOWS_7Z_SHA256=7fb1dfec805b97983763d7d0ae244320da12add1003d4249c96cc4d586398c79
# Windows only: libhackrf uses POSIX threads. Commit of tag Version-3-0-0-release.
PTHREADS4W_REPOSITORY=https://github.com/jwinarske/pthreads4w.git
PTHREADS4W_REF=07053a521b0a9deb6db2a649cde1f828f2eb1f4f
